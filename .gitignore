.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store
.env
# HTTP cache: re-fetchable, never committed
data/raw/
# Processed data is versioned separately (release artifact), not in git
data/processed/*
!data/processed/.gitkeep
# DEM tiles (GBs; re-downloadable, tile list kept in data/dem/*_tiles.csv)
data/dem/*.tif
data/dem/*.part

# Personal editor / notes app settings
.obsidian/
.vscode/
data/kb/
data/private/

# Private lab notes (unpublished results)
docs/lab_sensing/

# Crawler runtime state (frontier database, queue, reports): re-creatable
data/crawl/

# Cached model answers (re-creatable, keyed by model + prompt version + text)
data/cache/

# History archives (weather, alerts): kept locally, published through a data release, not git
data/history/

# Generated routing graphs (rebuilt by python -m atlas.export_routing)
data/map/routing/
# axe-core for accessibility tests (npm install --no-save --prefix ./.axe)
.axe/
eval/results/raw_*.json
node_modules/
