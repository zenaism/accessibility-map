# Copy to deploy/shared_server/env on the server and fill in. Keep that file and the key file private (chmod 600).
# anthropic (the Claude API; needs `pip install anthropic`) or openrouter
OPENWAY_PROVIDER=anthropic
OPENWAY_KEY_FILE=~/.config/openway/anthropic.key
# claude-haiku-5-5 on the Claude API; anthropic/claude-haiku-5.5 on OpenRouter
OPENWAY_CLOUD_MODEL=claude-haiku-5-5
# pages on other sites that may call the API, comma-separated, no trailing slash
OPENWAY_ALLOW_ORIGINS=https://zenaism.github.io,http://localhost:8002
OPENWAY_RATE_PER_HOUR=30
OPENWAY_RATE_PER_DAY=600
PORT=18002
